{
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2025",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/desktop/ui/*"],
      "perry/*": ["./.perry/types/perry/*/index.d.ts"]
    }
  },
  "include": ["src/desktop", "src/protocol", "src/checks", ".perry/types/stdlib/index.d.ts"]
}
