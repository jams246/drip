{
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2025",
    "paths": {
      "perry/*": ["./.perry/types/perry/*/index.d.ts"]
    }
  },
  "include": ["src", ".perry/types/stdlib/index.d.ts"]
}
