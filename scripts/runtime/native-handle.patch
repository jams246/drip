+#[cfg(test)]
+mod native_handle_tests {
+    use super::*;
+
+    #[test]
+    fn symbol_writes_keep_native_handles_out_of_heap_header_checks() {
+        let symbol = unsafe { crate::symbol::js_symbol_new_empty() };
+        for handle in [
+            0x10001,
+            65541,
+            crate::value::addr_class::COMMON_HANDLE_BAND_END - 1,
+            crate::value::addr_class::FETCH_HANDLE_BAND_START,
+            crate::value::addr_class::HANDLE_BAND_MAX - 1,
+        ] {
+            let value = crate::value::js_nanbox_pointer(handle as i64);
+            unsafe {
+                set_symbol_property(value, symbol, 7.0);
+            }
+            assert_eq!(
+                symbol_property_root_bits(handle, unsafe { sym_key_from_f64(symbol) }),
+                Some(7.0f64.to_bits())
+            );
+            assert!(!symbol_property_is_non_writable(value, symbol));
+            unsafe {
+                set_symbol_property(value, symbol, 8.0);
+            }
+            assert_eq!(
+                symbol_property_root_bits(handle, unsafe { sym_key_from_f64(symbol) }),
+                Some(8.0f64.to_bits())
+            );
+            unsafe {
+                js_object_delete_symbol_property(value, symbol);
+            }
+        }
+    }
+}
