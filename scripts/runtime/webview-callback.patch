+#[cfg(target_os = "windows")]
+impl PendingEvaluation {
+    fn new(callback: f64) -> Self {
+        static NEXT_EVALUATION_ID: AtomicI64 = AtomicI64::new(1);
+        let id = NEXT_EVALUATION_ID.fetch_add(1, Ordering::Relaxed);
+        PENDING_EVALUATIONS.with(|pending| {
