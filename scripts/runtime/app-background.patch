+#[cfg(target_os = "windows")]
+pub(crate) fn initial_background_color() -> Option<COLORREF> {
+    let Ok(value) = std::env::var("WEBVIEW2_DEFAULT_BACKGROUND_COLOR") else {
+        return None;
+    };
+    let value = value.strip_prefix("0x").or_else(|| value.strip_prefix("0X")).unwrap_or(&value);
+    if value.len() != 8 {
+        return None;
+    }
+    let Ok(argb) = u32::from_str_radix(value, 16) else {
+        return None;
+    };
+    let [alpha, red, green, blue] = argb.to_be_bytes();
+    if alpha != 255 {
+        return None;
+    }
+    Some(COLORREF(u32::from_le_bytes([red, green, blue, 0])))
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) fn initial_background_brush(fallback: HBRUSH) -> HBRUSH {
+    let Some(color) = initial_background_color() else {
+        return fallback;
+    };
+    let brush = unsafe { CreateSolidBrush(color) };
+    if brush.0.is_null() { fallback } else { brush }
+}
