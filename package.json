{
  "name": "drip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.ts",
  "imports": {
    "#drip-window-icon": "./src/desktop/ui/native/icon.ts"
  },
  "scripts": {
    "dev": "vite src/desktop",
    "build": "npm run typecheck && node scripts/build-frontend.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "preview": "vite preview src/desktop --outDir ../../dist/desktop"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "#drip-window-icon"
      ]
    },
    "compilePackages": []
  }
}
