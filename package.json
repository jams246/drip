{
  "name": "drip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.ts",
  "bin": {
    "drip": "dist/server/bootstrap/cli.js"
  },
  "imports": {
    "#drip-window-icon": "./src/desktop/ui/native/icon.ts"
  },
  "scripts": {
    "dev": "vite src/desktop",
    "build": "tsc --noEmit && node scripts/build-frontend.mjs && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview src/desktop --outDir ../../dist/desktop"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "#drip-window-icon"
      ],
      "compilePackages": [
        "@noble/hashes"
      ]
    },
    "compilePackages": [
      "@noble/hashes"
    ]
  }
}
